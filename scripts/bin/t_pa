#!/usr/bin/env bash
# tmux path abbreviation

w="${2:-10}"
p="$1"
h="${HOME%/}"

[ -n "$p" ] || p="$PWD"

out=""
c=""
if [ "$p" = "/" ]; then
  out='$HOME'
elif [ "$p" = "$h" ]; then
  out='$HOME'
elif [[ "$p" == "$h"/* ]]; then
  c="${p#"$h"/}"
  c="${c%/}"
  if [[ "$c" == */* ]]; then
    c="${c##*/}"
    out="../$c"
  else
    out="\$HOME/$c"
  fi
else
  c="${p##*/}"
  out="../$c"
fi

if [ -n "$c" ] && [ ${#c} -gt "$w" ]; then
  b="${out##*/}"
  out="${out%/*}/${b:0:$((w - 1))}…"
fi

printf '%s' "$out"
