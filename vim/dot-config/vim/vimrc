vim9script

packadd lsp
packadd! matchit
packadd! netrw
packadd! cfilter
packadd! justify
packadd! comment

import './autoload/helper_fns.vim' as hf
import './autoload/config/theming.vim' as theming
import './autoload/config/airline.vim' as airlineconf
import './autoload/config/fzf.vim' as fzfconf
import './autoload/config/fastfold.vim' as fastfoldconf
import './autoload/config/sneak.vim' as sneakconf
import './autoload/config/maps.vim' as maps
import './autoload/config/lsp.vim' as lspconf

set encoding=utf-8
scriptencoding utf-8

filetype plugin indent on
syntax enable

set termguicolors
set updatetime=300
set signcolumn=auto
set backspace=indent,eol,start
set fillchars=eob:\ ,vert:\|
set hlsearch
set wrap
set number relativenumber
set expandtab
set tabstop=2
set softtabstop=2
set shiftwidth=2
set incsearch
set noswapfile
set foldmethod=syntax
set foldenable
set foldlevelstart=99
set clipboard=unnamedplus

set background=dark

# let g:tsc_watcher_command="vpx tsc --noEmit --watch --pretty false --preserveWatchOutput"
# let g:tsc_watcher_shell=["/usr/bin/env", "zsh", "-c"]

hf.Init()
theming.AddConf()
airlineconf.Setup()
fzfconf.Setup()
fastfoldconf.Setup()
sneakconf.Setup()
maps.Init()
lspconf.Setup()
