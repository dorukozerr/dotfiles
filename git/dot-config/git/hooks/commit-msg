#!/usr/bin/env bash
# Abort commits whose message buffer was never saved (:q!), so a generated
# suggestion is never committed without being seen. Relies on the
# COMMIT_MSG_MTIME snapshot prepare-commit-msg leaves behind; -m, --amend,
# merges, and bypassed generation (no snapshot) always pass.
set -u

msg_file=$1

marker=$(git rev-parse --git-dir 2>/dev/null)/COMMIT_MSG_MTIME
[[ -f $marker ]] || exit 0
expected=$(cat "$marker")
actual=$(perl -MTime::HiRes=stat -e 'printf "%.9f", (stat($ARGV[0]))[9]' "$msg_file" 2>/dev/null)
rm -f "$marker"
if [[ $actual == "$expected" ]]; then
  echo "commit aborted: commit message buffer was not saved" >&2
  exit 1
fi
